{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvu-corpus.local/schemas/evaluation_result.schema.json",
  "title": "EvaluationResult",
  "type": "object",
  "required": [
    "evaluation_type",
    "schema_version",
    "modes",
    "source_artifacts",
    "outputs"
  ],
  "properties": {
    "evaluation_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
