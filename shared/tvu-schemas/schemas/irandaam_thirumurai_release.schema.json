{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tvu-corpus.local/schemas/irandaam_thirumurai_release.schema.json",
  "title": "Irandaam Thirumurai v1 Release Record",
  "type": "object",
  "required": [
    "record_type",
    "source",
    "source_site",
    "language",
    "domain",
    "genre",
    "religious_tradition",
    "collection",
    "work",
    "thirumurai",
    "thirumurai_number",
    "author",
    "hymn_id",
    "hymn_title",
    "hymn_location",
    "hymn_note",
    "pann",
    "song_no",
    "verse_index_in_hymn",
    "verse_text",
    "commentary_available",
    "pozhppurai",
    "kurippurai",
    "hymn_url",
    "commentary_url",
    "source_parameters",
    "text_statistics",
    "extraction_metadata"
  ],
  "properties": {
    "record_type": { "const": "verse_with_commentary" },
    "source": { "type": "string" },
    "source_site": { "type": "string" },
    "language": { "const": "ta" },
    "domain": { "type": "string" },
    "genre": { "type": "string" },
    "religious_tradition": { "type": "string" },
    "collection": { "type": "string" },
    "work": { "type": "string" },
    "thirumurai": { "type": "string" },
    "thirumurai_number": { "type": "integer" },
    "author": { "type": "string" },
    "hymn_id": { "type": "string" },
    "hymn_title": { "type": "string" },
    "hymn_location": { "type": "string" },
    "hymn_note": { "type": "string" },
    "pann": { "type": "string" },
    "song_no": { "type": "string" },
    "verse_index_in_hymn": { "type": "integer" },
    "verse_text": { "type": "string" },
    "commentary_available": { "type": "boolean" },
    "pozhppurai": { "type": "string" },
    "kurippurai": { "type": "string" },
    "hymn_url": { "type": "string" },
    "commentary_url": { "type": "string" },
    "source_parameters": { "type": "object" },
    "text_statistics": { "type": "object" },
    "extraction_metadata": { "type": "object" }
  },
  "additionalProperties": true
}
